# Environment Variables Template
# Copy to .env.local and fill in your values

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres

# App Configuration
NEXT_PUBLIC_APP_NAME=Bali Car Charter
NEXT_PUBLIC_APP_URL=https://balicarcharter.com
NEXT_PUBLIC_API_URL=https://api.balicarcharter.com

# Mapbox (50k loads free/month)
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=your-mapbox-token

# Xendit Payment (Sandbox first, then Production)
XENDIT_API_KEY=your-xendit-api-key
XENDIT_WEBHOOK_SECRET=your-xendit-webhook-secret

# WhatsApp Cloud API (Meta)
WHATSAPP_PHONE_NUMBER_ID=your-whatsapp-number-id
WHATSAPP_ACCESS_TOKEN=your-whatsapp-access-token
WHATSAPP_VERIFY_TOKEN=your-whatsapp-verify-token

# Gemini API (Free Tier)
GEMINI_API_KEY=your-gemini-api-key

# Secret Key for JWT
JWT_SECRET=your-jwt-secret
